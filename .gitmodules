[submodule "external/clap"]
	path = external/clap
	url = https://github.com/free-audio/clap
[submodule "dpf"]
	path = dpf
	url = https://github.com/erickampman/DPF.git
[submodule "external/clap-wrapper"]
	path = external/clap-wrapper
	url = https://github.com/free-audio/clap-wrapper.git
	ignore = dirty
[submodule "external/vst3sdk"]
	path = external/vst3sdk
	url = https://github.com/steinbergmedia/vst3sdk.git
[submodule "external/uw-core"]
	path = external/uw-core
	url = https://github.com/erickampman/uw-core.git
